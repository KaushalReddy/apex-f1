# Production settings: copy to .env in the repository root on the server (never commit it), then fill in every value marked REQUIRED.
# Used by docker-compose.yml + docker-compose.prod.yml (docs/DEPLOYMENT.md).

# REQUIRED: the public domain, already pointing at this server (A/AAAA record). Caddy gets its HTTPS certificate for it.
DOMAIN=apexf1.example.com

# REQUIRED: database password (long and random: openssl rand -hex 24). Used by Postgres and by the API.
POSTGRES_DB=apex
POSTGRES_USER=apex
POSTGRES_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
APEX_DB_URL=jdbc:postgresql://postgres:5432/apex
APEX_DB_USER=apex
APEX_DB_PASSWORD=

# REQUIRED: shared secret between the sync worker and the website (openssl rand -hex 32). With it, pages refresh the moment new races
# land and /api/sync/health works; without it pages still refresh within 15 minutes, and both protected routes stay disabled.
SYNC_SECRET=

# OpenF1 sync worker: seasons kept current and how often it checks.
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_SYNC_YEARS=2026
OPENF1_SYNC_INTERVAL_MIN=30
OPENF1_MIN_INTERVAL_MS=2100

# OPTIONAL: Race Engineer (Google Gemini). Without a key the engineer says it is not configured; everything else works.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL: live timing needs a paid OpenF1 real-time subscription. Without it, Live says live timing is unavailable and shows the
# previous race. The sync worker logs in with the same account, so it keeps syncing while a session is live (OpenF1 refuses anonymous
# requests then). Server-side only: never prefix these with NEXT_PUBLIC_.
OPENF1_USERNAME=
OPENF1_PASSWORD=
OPENF1_LIVE_POLL_MS=5000
OPENF1_LIVE_MIN_INTERVAL_MS=300
# Live car locations: first request reaches back this far; later ones re-read this much (late-arriving samples). Raise if OpenF1 lags.
OPENF1_LIVE_LOCATION_BACKFILL_MS=60000
OPENF1_LIVE_LOCATION_OVERLAP_MS=10000
