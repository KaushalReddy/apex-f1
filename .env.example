# Copy to .env (never commit .env). Local development defaults only.
POSTGRES_DB=apex
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me-locally

# Backend (apps/api)
SPRING_PROFILES_ACTIVE=dev
APEX_DB_URL=jdbc:postgresql://postgres:5432/apex
APEX_DB_USER=apex
APEX_DB_PASSWORD=change-me-locally

# OpenF1: historical data needs no credentials. Real-time needs an OpenF1 account (see docs/DATA_PIPELINE.md).
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Frontend (apps/web): the browser only ever talks to OUR backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
