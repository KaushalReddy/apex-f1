# Copy to .env (never commit .env). Local development defaults only.
POSTGRES_DB=apex
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me-locally

# Backend (apps/api)
SPRING_PROFILES_ACTIVE=dev
APEX_DB_URL=jdbc:postgresql://postgres:5432/apex
APEX_DB_USER=apex
APEX_DB_PASSWORD=change-me-locally

# OpenF1: historical data needs no credentials. Real-time needs a paid OpenF1 subscription (see docs/DATA_PIPELINE.md).
# Server-side only: never prefix these with NEXT_PUBLIC_.
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Live polling (only used with the credentials above): one OpenF1 poll per interval for all visitors.
OPENF1_LIVE_POLL_MS=5000
OPENF1_LIVE_MIN_INTERVAL_MS=300

# OpenF1 sync worker (tools/openf1-sync) and the website's synced-data directory (a persistent volume both share).
DATA_DIR=/data
OPENF1_SYNC_YEARS=2026
OPENF1_SYNC_INTERVAL_MIN=30
OPENF1_MIN_INTERVAL_MS=2100
# Shared secret: the worker calls the website's /api/revalidate with it; /api/sync/health requires it. Long and random (openssl rand -hex 32).
SYNC_SECRET=

# Frontend (apps/web): the browser only ever talks to OUR backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
