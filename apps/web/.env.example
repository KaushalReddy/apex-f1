# Copy to .env.local (never committed) and fill in.
# Google Gemini API key for the AI Race Engineer (/race-engineer and the replay's Engineer panel). Server-side only.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: the Gemini model to use (default gemini-2.5-flash).
# GEMINI_MODEL=

# Optional: data synced from OpenF1 after the build (tools/openf1-sync writes here). Without it, the bundled snapshot is used.
# DATA_DIR=
# Shared secret for /api/revalidate (called by the sync worker) and /api/sync/health. Without it both are disabled.
# SYNC_SECRET=
# Optional: OpenF1 real-time subscription (server only). Without it, /live says live timing is unavailable.
# OPENF1_USERNAME=
# OPENF1_PASSWORD=
